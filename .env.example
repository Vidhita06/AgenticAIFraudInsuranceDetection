# Copy to .env and fill in. The agent reads these via python-dotenv.
# Provider: anthropic | openai | ollama
LLM_PROVIDER=anthropic
# Main model (agent + synthesis) and a cheaper model for large batch runs
MODEL_NAME=claude-sonnet-5-5
BATCH_MODEL_NAME=claude-haiku-4-5-20251001
# API key for the chosen provider (ANTHROPIC_API_KEY / OPENAI_API_KEY also work)
LLM_API_KEY=
# Only for ollama
OLLAMA_BASE_URL=http://localhost:11434
