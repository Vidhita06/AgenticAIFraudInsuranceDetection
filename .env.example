# Copy to .env and uncomment ONE block. The agent and scripts/run_batch_triage.py read these
# variables (python-dotenv). Never commit .env.

# --- Option A: Ollama, free and local (no API key) --------------------------------------
# Needs a tool-capable model: qwen2.5 (recommended) or llama3.1.
#   laptop: ollama pull qwen2.5:7b      (~4.7 GB, 8+ GB RAM)
#   B200:   ollama pull qwen2.5:72b     (~47 GB, fits easily in GPU memory)
LLM_PROVIDER=ollama
MODEL_NAME=qwen2.5:7b
BATCH_MODEL_NAME=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
# Context window in tokens. Ollama's 2-4k default would truncate the agent's prompts.
OLLAMA_NUM_CTX=16384

# --- Option B: free OpenAI-compatible APIs (free tiers are rate-limited) ----------------
# Each needs a free API key from the provider. Model names change; check the provider's
# list for a model that supports tool calling. Use --pause 2 with low rate limits.
#
# Groq (https://console.groq.com/keys):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# MODEL_NAME=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...
#
# OpenRouter free models (https://openrouter.ai/keys; ":free" models):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=qwen/qwen-2.5-72b-instruct:free
# LLM_API_KEY=sk-or-...
#
# Google Gemini (https://aistudio.google.com/apikey; OpenAI-compatible endpoint):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL_NAME=gemini-2.5-flash
# LLM_API_KEY=AIza...
#
# Any local OpenAI-compatible server (vLLM, LM Studio, Ollama's /v1) needs no key:
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=qwen2.5:7b

# --- Option C: Anthropic (paid; the scripts show a cost estimate and ask first) ---------
# LLM_PROVIDER=anthropic
# MODEL_NAME=claude-sonnet-5-5
# BATCH_MODEL_NAME=claude-haiku-4-5-20251001
# LLM_API_KEY=sk-ant-...
